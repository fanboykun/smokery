# Production Dockerfile for the Smokery CLI.
# Produces a minimal image with just the static binary.
#
# Build:  docker build -f configs/Dockerfile.cli -t smokery-cli .
# Run:    docker run --rm -v $(pwd):/work smokery-cli run -c /work/config.yaml -s /work/spec.json

FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY apps/core/go.mod apps/core/go.sum ./
RUN go mod download
COPY apps/core/ .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /smokery ./cmd/smokery

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /smokery /usr/local/bin/smokery
ENTRYPOINT ["smokery"]
