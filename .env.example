# Smokery Server Configuration
# Copy to .env and adjust values for your environment.

# Server port
PORT=8080

# --- Adapter selection ---
# Database: "sqlite" (default) or "postgres"
DB_ADAPTER=sqlite

# Blob storage: "fs" (default) or "minio"
STORAGE_ADAPTER=fs

# --- SQLite (when DB_ADAPTER=sqlite) ---
SQLITE_PATH=data/smokery.db

# --- PostgreSQL (when DB_ADAPTER=postgres) ---
DATABASE_URL=postgres://smokery:smokery@localhost:5432/smokery?sslmode=disable

# --- Filesystem storage (when STORAGE_ADAPTER=fs) ---
STORAGE_PATH=data/artifacts

# --- MinIO / S3 (when STORAGE_ADAPTER=minio) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Retention: days to keep old run results before cleanup
RETENTION_DAYS=30
